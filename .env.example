# Sentinel AI - Environment Configuration (V1.5 Hybrid Platform)

# Core Server Settings
PROJECT_NAME="Sentinel AI"
VERSION="1.5.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
HOST="127.0.0.1"
PORT=8000
DATABASE_URL="sqlite:///./sentinel.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Centralized Threat Detection Thresholds (Configurable)
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60

PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW_SECONDS=30

DDOS_MIN_EVENTS=20
DDOS_MIN_SOURCES=3
DDOS_WINDOW_SECONDS=30

ANOMALOUS_SPIKE_THRESHOLD=20
ANOMALOUS_SPIKE_WINDOW_SECONDS=60

# Machine Learning Anomaly Detection Settings (Phase 4)
# Master feature flag enabling or disabling ML anomaly detection in the hybrid engine
ENABLE_ML_DETECTION=True
# Decision threshold for Isolation Forest anomaly score (scores < threshold trigger anomaly alert)
ML_ANOMALY_THRESHOLD=-0.0200
# Sliding observation time window in seconds for ML feature aggregation
ML_WINDOW_SECONDS=60
# Minimum number of security log events required within observation window before ML evaluation
ML_MIN_EVENTS=5
